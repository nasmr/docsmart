# Copy to .env for local development. Local-only credentials; never use these elsewhere.
# The owner, for migrations.
DATABASE_URL=postgres://docsmart:docsmart@127.0.0.1:5432/docsmart
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=docsmart
S3_SECRET_ACCESS_KEY=docsmart-local-only
S3_EVIDENCE_BUCKET=evidence

# The API (services/api). A login role in docsmart_app, never the owner.
APP_DATABASE_URL=postgres://docsmart_app_local:docsmart-app-local-only@127.0.0.1:5432/docsmart
PORT=3000
# Development sign-in only. Tokens of 16+ characters → { role, tenant_id, actor[, lawyer] }.
ALLOW_DEV_TOKENS=1
API_DEV_TOKENS={"dev-sponsor-token-0001":{"role":"sponsor","tenant_id":"meridian","actor":"sponsor_ops_1"},"dev-counsel-token-0001":{"role":"counsel","tenant_id":"meridian","actor":"law_bvi_1","lawyer":{"verified":true,"admissions":["VG"]}}}

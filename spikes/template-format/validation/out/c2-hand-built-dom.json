                  },
                  {
                    "$class": "org.accordproject.commonmark@0.5.0.Text",
                    "text": " a year."
                  }
                ],
                "whenFalse": [],
                "name": "has_hurdle"
              }
            ]
          }
        ]
      }
    ]
  },
  "results": {
    "true": {
      "ok": true,
      "text": "15% of profits plus a return of 8% a year.",
